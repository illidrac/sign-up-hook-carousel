        <div class="links-container">
          <div>Already have an account? <a href="#">Log in</a></div>
          <div>or <a href="#">Continue as guest</a></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State management
    const icon1 = document.getElementById('icon-1');
    const icon2 = document.getElementById('icon-2');
    const icon3 = document.getElementById('icon-3');

    const copy1 = document.getElementById('copy-1');
    const copy2 = document.getElementById('copy-2');
    const copy3 = document.getElementById('copy-3');

    const icons = [icon1, icon2, icon3];
    const copies = [copy1, copy2, copy3];
    const slotClasses = ['slot-left', 'slot-middle', 'slot-right'];

    const stateSlots = [
      [1, 2, 0], // State 1: Icon 1 in middle, Icon 2 in right, Icon 3 in left
      [0, 1, 2], // State 2: Icon 1 in left, Icon 2 in middle, Icon 3 in right
      [2, 0, 1]  // State 3: Icon 1 in right, Icon 2 in left, Icon 3 in middle
    ];

    let currentState = 0;
    const ctaBtn = document.getElementById('cta-btn');

    function updateCarousel() {
      const slots = stateSlots[currentState];
      
      icons.forEach((icon, index) => {
        icon.classList.remove(...slotClasses);
        const slotIdx = slots[index];
        icon.classList.add(slotClasses[slotIdx]);
      });

      copies.forEach((copy, index) => {
        if (index === currentState) {
          copy.classList.add('active');
        } else {
          copy.classList.remove('active');
        }
      });

      // Trigger intermediate lock bounce (lock 1A.svg) exactly halfway through the 2.0s loop cycle
      setTimeout(() => {
        ctaBtn.classList.add('active-lock');
        setTimeout(() => {
          ctaBtn.classList.remove('active-lock');
        }, 350); // Kept on for the duration of the transition
      }, 1000); // 1.0 second offset from the carousel shift (exactly mid-wait)
    }

    function rotateNext() {
      currentState = (currentState + 1) % 3;
      updateCarousel();
    }

    // Initialize first state
    updateCarousel();
    setInterval(rotateNext, 2000);
  </script>
</body>
</html>
