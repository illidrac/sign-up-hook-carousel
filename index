            <svg class="lock-open" viewBox="0 0 34 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15.6942 5.31934V10.6108H0V23.9233H18.3098V5.31934H15.6942ZM10.4627 21.2607H7.8471V13.3363H10.4627V21.2607Z" fill="white"/>
