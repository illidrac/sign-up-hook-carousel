<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Overlay Carousel Animation Demo</title>
  <style>
    /* Google Fonts */
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300&family=Inter:wght@300;400;600;700&display=swap');

    :root {
      --bg-color: #0e1225;
      --card-bg: #e6e8eb;
      --text-main: #232322;
      --navy: #19223e;
      --transition-speed: 0.5s;
    }

    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: var(--bg-color);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--text-main);
    }

    .container {
      width: 100%;
      max-width: 520px;
      padding: 20px;
      box-sizing: border-box;
    }

    /* Recreating the Overlay mockup style */
    .overlay-card {
      background: var(--card-bg);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.1);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Top calculating bar */
    .top-bar {
      display: flex;
      height: 38px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }
    
    .calc-left {
      width: 30%;
      background: #ededed;
      color: #717171;
      display: flex;
      align-items: center;
      padding-left: 15px;
    }

    .calc-right {
      width: 70%;
      background: var(--navy);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 15px;
    }

    .card-content {
      padding: 40px 35px 35px 35px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    h1 {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 2px;
      margin: 0 0 16px 0;
      text-transform: uppercase;
      color: var(--text-main);
    }

    .subtitle {
      font-size: 14px;
      line-height: 1.5;
      font-weight: 400;
      color: #333332;
      margin: 0 0 35px 0;
      max-width: 380px;
    }

    /* Carousel Animation Section */
    .carousel-section {
      width: 100%;
      height: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      margin-bottom: 25px;
    }

    /* Horizontal alignment of slots */
    .icons-row {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 60px;
      position: relative;
    }

    /* Individual Icon wrapper */
    .icon-wrapper {
      position: absolute;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: transform var(--transition-speed) cubic-bezier(0.4, 0.0, 0.2, 1), 
                  opacity var(--transition-speed) ease;
      width: 80px;
      height: 50px;
    }

    .icon-wrapper svg {
      max-width: 100%;
      max-height: 100%;
    }

    /* Slot Positions */
    .slot-left {
      transform: translateX(-100px) scale(0.85);
      opacity: 0.35;
    }

    .slot-middle {
      transform: translateX(0) scale(1.2);
      opacity: 1.0;
    }

    .slot-right {
      transform: translateX(100px) scale(0.85);
      opacity: 0.35;
    }

    /* Copy Transition container - Fixed height and baseline alignment */
    .copy-container {
      margin-top: 25px;
      height: 35px;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      width: 100%;
    }

    /* Text Copy style using the Cormorant Garamond Font */
    .copy-text-item {
      position: absolute;
      opacity: 0;
      transition: opacity var(--transition-speed) ease; /* STRICTLY IN-PLACE CROSS-FADE */
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-style: italic;
      font-weight: 300;
      color: var(--text-main);
      margin: 0;
      white-space: nowrap;
      text-shadow: 0 0 1px rgba(0,0,0,0.05);
    }

    .copy-text-item.active {
      opacity: 1;
    }

    /* CTA Button & Links */
    .btn-create-account {
      background: #000000;
      color: #ffffff;
      width: 100%;
      border: none;
      padding: 16px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 15px;
      margin-bottom: 25px;
      transition: background 0.2s ease;
    }

    .btn-create-account:hover {
      background: #1c1c1b;
    }

    /* Lock Icon Swapping container */
    .lock-icon-container {
      margin-right: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px; /* Matches the maximum width of lock 2 */
      height: 27px; /* Matches lock 1A height */
      position: relative;
    }

    .lock-icon-container svg {
      position: absolute;
    }

    /* SVG State Control (via state classes on cta-btn) */
    .lock-closed, .lock-active, .lock-open {
      display: none;
    }

    /* Default (Locked State) */
    #cta-btn:not(.active-lock):not(:hover) .lock-closed {
      display: block;
      width: 19px;
      height: 24px;
    }

    /* Intermediate/Active Shift State (Syncs in between carousel transitions) */
    #cta-btn.active-lock:not(:hover) .lock-active {
      display: block;
      width: 19px;
      height: 27px;
    }

    /* Hover/Unlocked State */
    #cta-btn:hover .lock-open {
      display: block;
      width: 34px;
      height: 24px;
    }

    .links-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .links-container span {
      color: #717171;
    }

    .links-container a {
      color: var(--text-main);
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: opacity 0.2s ease;
    }

    .links-container a:hover {
      opacity: 0.7;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Recreated Overlay Card -->
    <div class="overlay-card">
      <div class="top-bar">
        <div class="calc-left">Calculating</div>
        <div class="calc-right">30%</div>
      </div>

      <div class="card-content">
        <h1>Save your results</h1>
        <p class="subtitle">Create a free account while we calculate your score so it's ready when you return. Unlock all the benefits.</p>

        <!-- Dynamic Carousel Animation Section -->
        <div class="carousel-section">
          <div class="icons-row">
