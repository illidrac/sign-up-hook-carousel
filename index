                <path d="M23.0175 23.0127H17.2656V28.7646H23.0175V23.0127Z" fill="#232322"/>
              </svg>
            </div>
          </div>

          <!-- Dynamic Text Copy Section (Fixed heights, baselines, and in-place transition) -->
          <div class="copy-container">
            <h2 id="copy-1" class="copy-text-item">Decode your relationships</h2>
            <h2 id="copy-2" class="copy-text-item">Discover who you are</h2>
            <h2 id="copy-3" class="copy-text-item">Meet your future self</h2>
          </div>
        </div>

        <!-- Create Account CTA with Vector Lock Animation Swap -->
        <button class="btn-create-account" id="cta-btn">
          <span class="lock-icon-container">
            <!-- lock 1.svg (Locked state) -->
